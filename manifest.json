{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "BonkData Overwolf App",
    "author": "BonkData",
    "version": "1.0.0",
    "minimum-overwolf-version": "0.77.10",
    "description": "Sample application Overwolf + Electron",
    "dock_button_title": "BonkData",
    "icon": "megabonk_p4u2.png",
    "icon_gray": "megabonk_p4u2.png",
    "launcher_icon": "megabonk_p4u2.png",
    "window_icon": "megabonk_p4u2.png"
  },
  "permissions": [
    "GameInfo",
    "GameControl"
  ],
  "data": {
    "start_window": "MainWindow",
    "windows": {
      "MainWindow": {
        "file": "index.html",
        "transparent": false,
        "resizable": true,
        "show_in_taskbar": true,
        "size": {
          "width": 1200,
          "height": 800
        },
        "min_size": {
          "width": 800,
          "height": 600
        }
      }
    }
  }
}

